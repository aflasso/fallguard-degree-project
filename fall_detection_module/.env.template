# ── Servidor ──────────────────────────────────────────────────────────────────
# URL WebSocket del fall_detection_server
SERVER_WS_URL=ws://localhost:8000/ws
# URL HTTP del fall_detection_server
SERVER_HTTP_URL=http://localhost:8000

# ── Modelos ML ────────────────────────────────────────────────────────────────
# Ruta al modelo YOLO de detección de pose (descargar desde el repositorio de modelos)
YOLO_MODEL_PATH=models/yolo11x-pose.pt
# Ruta al modelo LSTM de detección de caídas (entrenado con los notebooks en /Modelo)
LSTM_MODEL_PATH=models/fall_lstm_final.pt
# Dispositivo de inferencia: "cpu", "cuda:0", "cuda:1", etc.
DEVICE=cpu

# ── Detección ─────────────────────────────────────────────────────────────────
# Umbral de confianza del modelo YOLO (0.0 - 1.0)
CONF_YOLO=0.8
# Umbral de confianza del modelo LSTM (0.0 - 1.0)
CONF_LSTM=0.7
# Frames consecutivos requeridos para confirmar una caída
MIN_FRAMES=3
# Segundos de espera antes de permitir una nueva alerta
ALERT_COOLDOWN=30

# ── Clip de video ─────────────────────────────────────────────────────────────
# Directorio donde se guardan los clips generados
CLIPS_DIR=data/clips
# Frames de contexto previos a la caída
CONTEXT_BEFORE=75
# Frames de contexto posteriores a la caída
CONTEXT_AFTER=50
# FPS del video de salida
VIDEO_FPS=25.0

# ── Cola local ────────────────────────────────────────────────────────────────
# Ruta del archivo de alertas pendientes (cuando no hay conexión al servidor)
LOCAL_QUEUE_PATH=data/pending_alerts.json

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Fuente de video ───────────────────────────────────────────────────────────
# 0 = webcam por defecto, o ruta a un archivo de video para pruebas
CAMERA_SOURCE=0
