# Copiar como docker.env y completar los valores

# ── Servidor ──────────────────────────────────────────────────────────────────
# En Docker Desktop (Windows/Mac) host.docker.internal apunta al host automáticamente.
# En Linux se resuelve via extra_hosts: host-gateway en docker-compose.yml.
# Servidor dockerizado en la red fallguard
SERVER_WS_URL=ws://fall-detection-server:8000/ws
SERVER_HTTP_URL=http://fall-detection-server:8000

# Debe coincidir exactamente con MODULE_API_KEY del fall_detection_server
MODULE_API_KEY=your-module-api-key-here

# ── Modelos ───────────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=models/yolo11x-pose.pt
LSTM_MODEL_PATH=models/fall_lstm_final.pt
# DEVICE se define por servicio en docker-compose.yml (cuda:0)

# ── Detección ─────────────────────────────────────────────────────────────────
CONF_YOLO=0.8
CONF_LSTM=0.7
MIN_FRAMES=3
ALERT_COOLDOWN=30

# ── Cámara ────────────────────────────────────────────────────────────────────
# Valor de ARRANQUE únicamente. La fuente real la elige el usuario desde la app
# y el servidor la empuja por WebSocket; queda persistida en data/camera_source.txt
# y desde entonces esta variable se ignora.
# Vacío = el módulo arranca sin cámara y espera configuración desde la app.
#
# Celular como cámara IP (app "IP Webcam", Android) — MJPEG sobre HTTP.
# Reservar la IP en el router para que no cambie entre reinicios del celular.
CAMERA_SOURCE=http://<ip-del-celular>:8080/video

# Alternativa RTSP (H.264). Descomentar ambas líneas y comentar la de arriba.
# CAMERA_SOURCE=rtsp://<ip-del-celular>:8554/live
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp

# Timeouts del stream (ms). READ dispara la reconexión cuando la cámara se
# congela sin cerrar el socket. Subirlo si la red es lenta y hay falsos cortes.
CAMERA_OPEN_TIMEOUT_MS=5000
CAMERA_READ_TIMEOUT_MS=5000

# ── Clip de video ─────────────────────────────────────────────────────────────
# Los frames de contexto están calibrados a 30 fps (~3s antes, ~2s después).
# Deben moverse junto con VIDEO_FPS si el stream publica a otra tasa.
CLIPS_DIR=data/clips
CONTEXT_BEFORE=90
CONTEXT_AFTER=60
VIDEO_FPS=30.0

# ── Cola local ────────────────────────────────────────────────────────────────
LOCAL_QUEUE_PATH=data/pending_alerts.json

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
