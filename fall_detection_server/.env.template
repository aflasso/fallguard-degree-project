# ── Firebase ──────────────────────────────────────────────────────────────────
# Ruta al archivo serviceAccountKey.json descargado desde Firebase Console
# Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=credentials/serviceAccountKey.json

# ── Google Cloud Storage ──────────────────────────────────────────────────────
# Nombre del bucket de Firebase Storage (sin gs://)
# Firebase Console → Storage → nombre del bucket
GCS_BUCKET_NAME=your-project-id.firebasestorage.app

# ── Servidor ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── WebSocket ─────────────────────────────────────────────────────────────────
# API key que deben presentar los módulos locales al conectarse via WebSocket
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
MODULE_API_KEY=your-module-api-key-here
